# syntax=docker/dockerfile:1

# PyTorch version shared by the build and runtime stages
ARG TORCH_VERSION=2.15.0

############################
# 1. Base stage
############################
FROM ubuntu:24.04 AS base

ARG TORCH_VERSION

LABEL maintainer="Atsushi TAKEDA @takedarts"

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/prod

# Install build dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git make g++ ca-certificates \
        python3.12 python3.12-dev python3-pip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install python modules
RUN pip3 install --no-cache-dir --break-system-packages \
        cython cmake numpy \
    && pip3 install --no-cache-dir --break-system-packages \
        torch==${TORCH_VERSION} --index-url https://download.pytorch.org/whl/cpu

############################
# 2. Build stage
############################
FROM base AS builder

# Clone the repository and build the project
ARG BRANCH=main
RUN git clone --branch ${BRANCH} --depth=1 https://github.com/takedarts/gokaku . \
    && python3 src/build.py \
    && rm -rf src/deepshogi/native/build

############################
# 3. Runtime stage
############################
FROM ubuntu:24.04 AS runtime

ARG TORCH_VERSION

LABEL maintainer="Atsushi TAKEDA @takedarts"

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/prod

# Install runtime dependencies and python modules in a single layer to minimize the image size
# - g++ is required to compile ExportedProgram models with AOTInductor
# - pip is used only for installation and removed afterwards
# - torch/test contains test binaries of PyTorch, which are not needed at runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        g++ python3 python3.12 libpython3.12t64 python3-pip \
    && pip3 install --no-cache-dir --break-system-packages \
        numpy \
    && pip3 install --no-cache-dir --break-system-packages \
        torch==${TORCH_VERSION} --index-url https://download.pytorch.org/whl/cpu \
    && rm -rf /usr/local/lib/python3.12/dist-packages/torch/test \
    && apt-get purge -y python3-pip \
    && apt-get autoremove -y --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Suppress the warning that Python.h is not found when compiling models with AOTInductor
# (Python headers are not needed to build AOTInductor packages)
ENV PYTHONWARNINGS="ignore:Can't find Python.h:UserWarning"

# Copy the built project from the builder stage
COPY --from=builder /opt/prod /opt/prod

# Copy the launcher scripts
COPY --chmod=755 run.sh /opt/run.sh
COPY --chmod=755 compile.sh /opt/compile.sh
COPY --chmod=755 pnsolver.sh /opt/pnsolver.sh

WORKDIR /workspace

# Set the default command to display help
CMD ["/opt/run.sh", "--help"]
